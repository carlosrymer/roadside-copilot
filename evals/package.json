{
  "name": "roadside-copilot-evals",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Teaching-first evaluation harness for the Roadside Co-Pilot agent",
  "scripts": {
    "eval": "tsx src/evaluate.ts datasets/golden.json",
    "eval:gate": "tsx src/evaluate.ts datasets/regression.json --gate",
    "eval:judge": "tsx src/evaluate.ts datasets/golden.json --judge --model=live",
    "eval:live": "tsx src/evaluate.ts datasets/golden.json --model=live",
    "eval:broken": "tsx src/evaluate.ts datasets/golden.json --mutate",
    "diff": "tsx src/evaluate.ts datasets/golden.json --diff",
    "baseline:update": "tsx src/evaluate.ts datasets/golden.json --update-baseline",
    "record": "tsx src/evaluate.ts datasets/golden.json --model=live --record",
    "fixtures:rehash": "tsx src/rehash.ts",
    "judge:calibrate": "tsx src/calibrate.ts",
    "test": "node --import tsx --test src/meta/*.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1"
  }
}
